#VSCODE Plugin Rest Client: humao.rest-client

# Variables
@baseUrl = http://localhost:9000
@loansBaseUrl = {{baseUrl}}/loans
@securePasswordBaseUrl = {{baseUrl}}/secure-password
@pointsOfInterestBaseUrl = {{baseUrl}}/points-of-interest


# Requests: Desafio Loans
POST {{loansBaseUrl}}/customer-loans HTTP/1.1
Content-Type: application/json

{
    "age": 26,
    "cpf": "275.484.389-23",
    "name": "Vuxaywua Zukiagou",
    "income": 5000.00,
    "location": "SP"
}

###

# Requests: Desafio Secure Password

POST {{securePasswordBaseUrl}}/validate-password HTTP/1.1
Content-Type: application/json

{
    "password": "Ab@12345678"
}

###

